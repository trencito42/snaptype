{
  "name": "snaptype-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:packages": "npm run build -w packages/shared -w packages/snippet-engine -w packages/browser-compat",
    "build:api": "npm run build -w apps/api",
    "build:web": "npm run build -w apps/web",
    "start:web:wings": "node apps/web/serve.mjs",
    "build:extension": "npm run build -w apps/extension",
    "build:extension:prod": "npm run build:prod -w apps/extension",
    "build:extension:chrome": "npm run build:chrome -w apps/extension",
    "build:extension:firefox": "npm run build:firefox -w apps/extension",
    "package:extensions": "npm run package -w apps/extension",
    "package:extensions:prod": "npm run package:prod -w apps/extension",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "tsc --noEmit -p packages/shared/tsconfig.json && tsc --noEmit -p packages/snippet-engine/tsconfig.json && tsc --noEmit -p packages/browser-compat/tsconfig.json && tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/extension/tsconfig.json",
    "typecheck:extension": "tsc --noEmit -p apps/extension/tsconfig.json",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev": "npm run dev -w apps/api & npm run dev -w apps/web"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "archiver": "^7.0.1",
    "selenium-webdriver": "^4.51.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
