# Example Blipmade Git Deploy environment variables (app.env).
# Copy the section for each instance into the Blipmade Deploy tab — never commit real secrets.

# --- Instance A: SnapType Web (Node.js 22, snaptype.org) ---
# Required at build time (sourced before BUILD_CMD):
# VITE_SNAPTYPE_DEPLOY_TARGET=blipmade
# VITE_API_BASE=https://api.snaptype.org/api/v1
# Optional marketing canonical (used in HTML if wired):
# VITE_APP_URL=https://snaptype.org

# --- Instance B: SnapType API (Node.js 22, api.snaptype.org) ---
NODE_ENV=production
HOST=0.0.0.0
DB_DRIVER=mysql
# Set after database instance is provisioned (internal node IP + allocation port, not a public hostname):
# DATABASE_URL=mysql://snaptype_user:REPLACE_ME@10.x.x.x:30xxx/snaptype_db
APP_URL=https://snaptype.org
ALLOWED_ORIGINS=https://snaptype.org,https://api.snaptype.org
TRUST_PROXY=true
JWT_SECRET=replace_with_openssl_rand_hex_32_minimum
OTP_HMAC_SECRET=replace_with_openssl_rand_hex_32_minimum
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SnapType <noreply@snaptype.org>
SMTP_SECURE=false

# --- Instance C: SnapType Database (MySQL 8 product) ---
# Credentials are generated by Blipmade / owner SQL grants — do not store here.
