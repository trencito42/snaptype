# SnapType Environment Configuration

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3000

# Security Secrets
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
OTP_HMAC_SECRET=super-secret-otp-hmac-key-replace-in-production

# MySQL Database
DATABASE_URL=mysql://snaptype_user:snaptype_pass@127.0.0.1:3306/snaptype_db
# In environments without active MySQL, set to 'memory' or 'sqlite' for tests/embedded mode
DB_DRIVER=mysql

# SMTP Email Delivery (Leave blank in development to print OTP codes directly to console/logger)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SnapType Verification <noreply@snaptype.app>"
SMTP_SECURE=false

