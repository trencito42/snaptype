# SnapType Docker Compose Environment Template
# Copy to .env: cp .env.docker.example .env
# Generate random secrets with: openssl rand -hex 32

# Database Passwords (REQUIRED)
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password_32_chars
MYSQL_DATABASE=snaptype_db
MYSQL_USER=snaptype_user
MYSQL_PASSWORD=replace_with_strong_user_password_32_chars

# Application Authentication & HMAC Secrets (REQUIRED - min 32 chars)
JWT_SECRET=replace_with_openssl_rand_hex_32_jwt_secret
OTP_HMAC_SECRET=replace_with_openssl_rand_hex_32_otp_secret

# External Public URL & Port
APP_URL=http://localhost:8080
WEB_PORT=8080

# Production SMTP Configuration
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
SMTP_FROM="SnapType Verification <noreply@yourdomain.com>"
